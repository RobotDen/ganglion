# Base image for Ganglion test harness nodes.
# Provides networking tools for simulating hostile network conditions.
FROM rust:1.85-slim-bookworm AS builder

RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

# Copy manifests first for layer caching
COPY Cargo.toml Cargo.lock ./
COPY crates/ crates/

# Remove rust-toolchain.toml if present — the wasm32-wasip2 target is not
# needed for the CLI binary and is not available in this base image.
RUN rm -f rust-toolchain.toml

# Build only the gang CLI binary (it transitively pulls in gang-ros and
# everything else). Skip gang-ros as a standalone build since the CLI
# already depends on it.
RUN cargo build --release -p gang

FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y \
    iproute2 \
    iptables \
    iputils-ping \
    net-tools \
    curl \
    dnsutils \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /build/target/release/gang /usr/local/bin/gang

# Pre-create data directory
RUN mkdir -p /data

# Default entrypoint runs the gang CLI
ENTRYPOINT ["gang"]
