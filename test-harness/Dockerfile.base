# Base image for Ganglion test harness nodes.
# Provides networking tools for simulating hostile network conditions.
FROM rust:1.85-slim-bookworm AS builder

RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build
COPY . .
RUN cargo build --release -p gang -p gang-ros

FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y \
    iproute2 \
    iptables \
    iputils-ping \
    net-tools \
    curl \
    dnsutils \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /build/target/release/gang /usr/local/bin/gang

# Default entrypoint runs the gang CLI
ENTRYPOINT ["gang"]
