#!/usr/bin/env bash
# Ganglion pre-commit hook
# Install: git config core.hooksPath .githooks
# Or run: ./scripts/setup-hooks.sh

set -e

echo "=== pre-commit: cargo fmt --check ==="
if ! cargo fmt --check; then
    echo ""
    echo "Formatting check failed. Run 'cargo fmt' and try again."
    exit 1
fi

echo "=== pre-commit: cargo clippy ==="
if ! cargo clippy --all-targets --quiet -- -D warnings; then
    echo ""
    echo "Clippy found warnings treated as errors."
    echo "Run 'cargo clippy --all-targets' to see details."
    exit 1
fi

echo "=== pre-commit: cargo test ==="
if ! cargo test --quiet; then
    echo ""
    echo "Tests failed. Fix failing tests before committing."
    exit 1
fi

echo "=== pre-commit: all checks passed ==="
