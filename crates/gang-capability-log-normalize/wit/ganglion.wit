// VENDORED from crates/gang-wasm-host/wit/ganglion.wit — the canonical copy.
// Keep in sync (checked by .githooks/pre-commit). Vendored so each capability
// crate is self-contained and publishable to crates.io.
// Ganglion WIT capability interface definitions — v0.5
//
// All WASM components interact with the host through these interfaces.
// A component declares which interfaces it needs in its signed manifest.
// The host links every interface (plus a deny-by-default WASI 0.2 set for
// toolchain-generated imports); calls to capability groups not declared in
// the manifest are denied at call time.

package ganglion:capability@0.5.0;

/// ROS 2 interface — topic subscribe, service call, parameter access.
/// Pattern-gated: each operation is checked against the manifest's declared patterns.
interface ros-interface {
    /// A single ROS topic/service/parameter listing entry.
    record ros-entry {
        name: string,
        entry-type: string,
    }

    /// List all available topics, services, and nodes.
    list-ros: func() -> result<list<ros-entry>, string>;

    /// Subscribe to a topic and get current data.
    /// Returns serialized message data.
    topic-subscribe: func(topic: string) -> result<list<u8>, string>;

    /// Call a ROS service with a serialized request.
    service-call: func(service: string, request: list<u8>) -> result<list<u8>, string>;

    /// Get a parameter value.
    param-get: func(name: string) -> result<list<u8>, string>;

    /// Set a parameter value. Requires read-write access.
    param-set: func(name: string, value: list<u8>) -> result<bool, string>;
}

/// Log streaming — enumerate sources and stream log lines.
/// Source-pattern gated.
interface logs-stream {
    /// A log source descriptor.
    record log-source {
        name: string,
        source-type: string,
    }

    /// List available log sources.
    list-sources: func() -> result<list<log-source>, string>;

    /// Stream log lines from a source matching a pattern.
    /// Returns matching log lines.
    stream-logs: func(source: string, pattern: string) -> result<list<string>, string>;
}

/// Bounded filesystem access — path-pattern gated with read/write flags.
interface fs-bounded {
    /// File metadata.
    record file-stat {
        size: u64,
        is-dir: bool,
        is-file: bool,
        modified: u64,
    }

    /// Read a file's contents.
    read-file: func(path: string) -> result<list<u8>, string>;

    /// Write data to a file.
    write-file: func(path: string, data: list<u8>) -> result<_, string>;

    /// List directory contents.
    list-dir: func(path: string) -> result<list<string>, string>;

    /// Get file metadata.
    stat-file: func(path: string) -> result<file-stat, string>;
}

/// Structured diagnostic collection — system info, processes, network.
interface diagnostics-collect {
    /// Key-value diagnostic entry.
    record diagnostic-entry {
        key: string,
        value: string,
    }

    /// Collect system information (hostname, OS, arch, memory, etc.).
    system-info: func() -> result<list<diagnostic-entry>, string>;

    /// List running processes.
    process-list: func() -> result<list<string>, string>;

    /// Collect network state (interfaces, routes, connections).
    network-state: func() -> result<list<diagnostic-entry>, string>;
}

/// Content-addressed artifact publishing — v0.3.
/// Capabilities can publish byte streams as content-addressed artifacts.
interface artifacts-publish {
    /// Publish a byte stream as a content-addressed artifact.
    /// Returns the CID (content identifier) of the stored artifact.
    publish: func(data: list<u8>, filename: option<string>, content-type: option<string>) -> result<string, string>;

    /// Check if an artifact exists locally by CID.
    exists: func(cid: string) -> bool;
}

/// Bounded subprocess invocation — v0.4.
/// Components can spawn allowlisted subprocesses with captured stdio and resource limits.
interface process-spawn {
    /// Result of a spawned process.
    record process-result {
        exit-code: s32,
        stdout: list<u8>,
        stderr: list<u8>,
    }

    /// Spawn a subprocess. Command must be on the host allowlist.
    /// Returns stdout/stderr and exit code.
    spawn: func(command: string, args: list<string>, timeout-secs: u64) -> result<process-result, string>;

    /// Spawn with environment variables and working directory.
    spawn-with-env: func(
        command: string,
        args: list<string>,
        env: list<tuple<string, string>>,
        cwd: option<string>,
        timeout-secs: u64,
    ) -> result<process-result, string>;
}

/// Structured network probing primitives — v0.4.
/// Used by archetype detection and network diagnostics capabilities.
interface network-probe {
    /// Ping result for a single host.
    record ping-result {
        host: string,
        reachable: bool,
        rtt-ms: f64,
        packets-sent: u32,
        packets-received: u32,
    }

    /// DNS lookup result.
    record dns-result {
        hostname: string,
        record-type: string,
        answers: list<string>,
    }

    /// Port check result.
    record port-result {
        host: string,
        port: u16,
        open: bool,
        latency-ms: f64,
    }

    /// Traceroute hop.
    record traceroute-hop {
        hop: u32,
        address: string,
        rtt-ms: f64,
    }

    /// Ping a host.
    ping: func(host: string, count: u32) -> result<ping-result, string>;

    /// DNS lookup.
    dns-lookup: func(hostname: string, record-type: string) -> result<dns-result, string>;

    /// Check if a TCP port is open.
    port-check: func(host: string, port: u16, timeout-secs: u64) -> result<port-result, string>;

    /// Traceroute to a host.
    traceroute: func(host: string, max-hops: u32) -> result<list<traceroute-hop>, string>;
}

/// Structured metric emission — v0.4.
/// Capabilities emit metrics back to the operator for monitoring and alerting.
interface metrics-emit {
    /// A single metric data point.
    record metric-point {
        name: string,
        value: f64,
        unit: option<string>,
        tags: list<tuple<string, string>>,
    }

    /// Emit a single metric.
    emit: func(metric: metric-point) -> result<_, string>;

    /// Emit a batch of metrics.
    emit-batch: func(metrics: list<metric-point>) -> result<_, string>;
}

/// The world that Ganglion capabilities target.
/// A component imports whichever interfaces it needs.
world ganglion-capability {
    import ros-interface;
    import logs-stream;
    import fs-bounded;
    import diagnostics-collect;
    import artifacts-publish;
    import process-spawn;
    import network-probe;
    import metrics-emit;

    /// The capability's entry point. Returns serialized result data.
    export run: func(args: list<string>) -> result<list<u8>, string>;
}
